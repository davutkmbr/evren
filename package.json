{
  "name": "evren",
  "private": true,
  "version": "0.1.0",
  "description": "A realistic, open-world dragon-riding flight simulation over Istanbul, generated entirely in code with Three.js.",
  "license": "MIT",
  "author": "Davut Kember <davutkmbr@gmail.com>",
  "homepage": "https://davutkmbr.github.io/evren/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davutkmbr/evren.git"
  },
  "keywords": [
    "threejs",
    "webgl",
    "flight-simulator",
    "dragon",
    "istanbul",
    "procedural",
    "open-world",
    "game"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "snap": "node scripts/snap.mjs",
    "walk-test": "node scripts/walk-test.mjs",
    "compile:world": "tsx tools/world-compiler/src/cli.ts",
    "typecheck:world": "tsc -p tools/world-compiler/tsconfig.json",
    "blender": "node scripts/blender-run.mjs"
  },
  "dependencies": {
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.0",
    "@types/node": "^24.13.6",
    "@types/three": "^0.186.0",
    "gltf-validator": "^2.0.0-dev.3.10",
    "meshoptimizer": "^1.2.0",
    "playwright-core": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
