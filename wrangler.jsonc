// Seventeen Skies on Cloudflare Workers: the web build (npm run build:web -> dist/) as static assets, free and
// unmetered. worker/index.ts runs only for run_worker_first paths; see .docs/planning/26-online.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "seventeen-skies",
  "compatibility_date": "2026-09-27",
  "main": "worker/index.ts",
  // Served only on seventeenskies.com: no workers.dev or preview URLs.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // US-risky historic recordings (geo-gated) and the API.
    "run_worker_first": ["/audio/music/private/*", "/api/*"]
  },
  "durable_objects": {
    "bindings": [
      // Latency probe (worker/probe.ts): echo objects per location hint and the result log.
      { "name": "PROBE", "class_name": "LatencyProbe" },
      { "name": "PROBE_LOG", "class_name": "ProbeLog" },
      // Game servers (worker/rooms.ts): one room per named server.
      { "name": "ROOMS", "class_name": "ServerRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["LatencyProbe", "ProbeLog"] },
    { "tag": "v2", "new_sqlite_classes": ["ServerRoom"] }
  ],
  "observability": { "enabled": true },
  "routes": [
    { "pattern": "seventeenskies.com", "custom_domain": true },
    { "pattern": "www.seventeenskies.com", "custom_domain": true }
  ]
}
