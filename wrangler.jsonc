// Seventeen Skies on Cloudflare Workers: the web build (npm run build:web -> dist/) as static assets, free and
// unmetered. worker/index.ts runs only for run_worker_first paths; see .docs/planning/26-online.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "seventeen-skies",
  "compatibility_date": "2026-09-27",
  "main": "worker/index.ts",
  // Served only on seventeenskies.com: no workers.dev or preview URLs.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // US-risky historic recordings (geo-gated) and the API.
    "run_worker_first": ["/audio/music/private/*", "/api/*"]
  },
  "durable_objects": {
    "bindings": [
      // Latency probe (worker/probe.ts): echo objects per location hint and the result log.
      { "name": "PROBE", "class_name": "LatencyProbe" },
      { "name": "PROBE_LOG", "class_name": "ProbeLog" },
      // Game servers (worker/rooms.ts): one room per named server.
      { "name": "ROOMS", "class_name": "ServerRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["LatencyProbe", "ProbeLog"] },
    { "tag": "v2", "new_sqlite_classes": ["ServerRoom"] }
  ],
  // Accounts and profiles (worker/auth.ts, worker/account.ts); schema in migrations/.
  "d1_databases": [
    { "binding": "DB", "database_name": "seventeen-skies", "database_id": "0ab10fb3-8136-4d12-a40a-8eb0cc51f952", "migrations_dir": "migrations" }
  ],
  // Abuse limits (worker/lib/rate-limit.ts): sign-ins per IP, profile writes per account. Period 10 or 60 s.
  "ratelimits": [
    { "name": "SIGN_IN_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "PROFILE_LIMIT", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } }
  ],
  // Public settings; secrets (BETTER_AUTH_SECRET, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, STEAM_WEB_API_KEY) via
  // `wrangler secret put`, locally in .dev.vars. Steam sign-in (worker/steam) stays off until STEAM_AUTH is "on" with
  // STEAM_APP_ID and the STEAM_WEB_API_KEY secret set.
  "vars": { "BETTER_AUTH_URL": "https://seventeenskies.com", "STEAM_AUTH": "off", "STEAM_APP_ID": "" },
  "observability": { "enabled": true },
  "routes": [
    { "pattern": "seventeenskies.com", "custom_domain": true },
    { "pattern": "www.seventeenskies.com", "custom_domain": true }
  ]
}
