// Seventeen Skies on Cloudflare Workers: an assets-only Worker serving the web build (npm run build:web -> dist/).
// Static asset requests are free and unmetered; see .docs/planning/26-online.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "seventeen-skies",
  "compatibility_date": "2026-09-27",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "seventeenskies.com", "custom_domain": true },
    { "pattern": "www.seventeenskies.com", "custom_domain": true }
  ]
}
